# Copy to .env (never commit .env). Change every value before first run.
ASPNETCORE_ENVIRONMENT=Production

# Signs login tokens. At least 32 characters. Generate with: openssl rand -base64 48
AUTH_JWT_SIGNING_KEY=change-me-to-a-long-random-value-from-openssl

# Console = login codes are written to the API log instead of sent (development only).
SMS_PROVIDER=Console

POSTGRES_DB=portsyncs
POSTGRES_USER=portsyncs
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=portsyncs
RABBITMQ_PASSWORD=change-me
