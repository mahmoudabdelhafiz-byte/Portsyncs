# Copy to .env (never commit .env). Change every value before first run.
ASPNETCORE_ENVIRONMENT=Production

# Unauthenticated business endpoints for local testing only, until login (T20) exists.
# Keep false on any server that holds real data.
DEV_ENDPOINTS=false

POSTGRES_DB=portsyncs
POSTGRES_USER=portsyncs
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=portsyncs
RABBITMQ_PASSWORD=change-me
